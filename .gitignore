# ---------------------------------------------------------------------------
# Never commit game data. This repository ships tools only.
#
# gamedata/ holds everything belonging to Blizzard or Nintendo, or derived from
# it: ROMs, installers, extracted MPQ archives, and the maps and briefings this
# project produces. The whole tree is ignored; only its README is tracked.
# The extension rules below are a second line of defence in case something
# lands outside it.
# ---------------------------------------------------------------------------
/gamedata/*
!/gamedata/README.md

*.n64
*.z64
*.v64
*.rom

# Game archives and installers -- Blizzard's data, never ours to commit
*.mpq
*.MPQ
*.exe
*.smk
*.pcx

*.scm
*.scx
*.chk
*.script
briefings.json

maps/
briefings/
bolt-out/
out/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Build output from the vendored C++ projects
reference/*/build/
reference/*/build-*/
reference/*/x64/
reference/*/Debug/
reference/*/Release/
*.obj
*.o
*.lib
*.a
*.exe
*.pdb
*.ilk

# Tooling / OS
.rstk/
**/.sf/
**/.sfdx/
**/node_modules/
.DS_Store
Thumbs.db
desktop.ini
